config UDC_BFLB_V2
	bool "Bouffalo Lab USB V2 device controller driver"
	default y
	depends on DT_HAS_BFLB_UDC_2_ENABLED
	select UDC_DRIVER_HAS_HIGH_SPEED_SUPPORT
	imply UDC_WORKQUEUE
	help
	  USB 2.0 device controller driver for Bouffalo Lab SoCs
	  with the USB V2 peripheral.
	  Supports high-speed operation and exposes EP0 plus
	  four shared DMA-backed data endpoints.

if UDC_BFLB_V2

choice UDC_BFLB_V2_FIFO_SETUP
	bool "How many FIFOs are used per endpoint"
	default UDC_BFLB_V2_FIFO_BIDIR

config UDC_BFLB_V2_FIFO_MONODIR
	bool "Use a FIFO per endpoint direction"
	help
	  Use one FIFO per endpoint direction: Limits usable endpoints to two.

config UDC_BFLB_V2_FIFO_BIDIR
	bool "Use a FIFO for both endpoint directions"
	help
	  Use a single FIFO for both endpoint direction.

endchoice

config UDC_BFLB_V2_EP1_IN_FIFO_BLOCKS
	int "FIFO blocks buffering endpoint 1 IN"
	depends on UDC_BFLB_V2_FIFO_BIDIR
	range 1 3
	default 1
	help
	  Number of FIFO blocks chained behind endpoint 1 IN, so that the
	  controller fills one block while the host reads another. A bulk
	  stream needs more than one to keep up at high speed. Each block
	  above the first takes the FIFO of the following endpoint, which can
	  then not be used.

config UDC_BFLB_V2_EVENT_COUNT
	int "Number or blocks in event slab"
	range 8 32
	default 16
	help
	  Number of blocks in slab for internal endpoint events.

endif # UDC_BFLB_V2
