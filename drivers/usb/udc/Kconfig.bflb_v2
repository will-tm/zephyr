config UDC_BFLB_V2
	bool "Bouffalo Lab USB V2 device controller driver"
	default y
	depends on DT_HAS_BFLB_UDC_2_ENABLED
	select EVENTS
	select UDC_DRIVER_HAS_HIGH_SPEED_SUPPORT
	help
	  USB 2.0 device controller driver for Bouffalo Lab SoCs
	  with the USB V2 peripheral (FOTG210-like).
	  Supports high-speed operation and exposes EP0 plus
	  four shared DMA-backed data endpoints.

if UDC_BFLB_V2

config UDC_BFLB_V2_STACK_SIZE
	int "USB V2 UDC driver internal thread stack size"
	default 1024

config UDC_BFLB_V2_THREAD_PRIORITY
	int "USB V2 UDC driver internal thread priority"
	default 8

config UDC_BFLB_V2_EVENT_COUNT
	int "Number of blocks in event slab"
	range 8 32
	default 16

config UDC_BFLB_V2_FIFO_BIDIR
	bool "Use bidirectional FIFOs (one FIFO per endpoint)"
	default n
	help
	  Use one FIFO per endpoint in bidirectional mode, supporting
	  up to 4 data endpoints. When disabled, each direction gets
	  its own FIFO, limiting the controller to 2 data endpoints.

endif # UDC_BFLB_V2
